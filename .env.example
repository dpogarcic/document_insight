DATABASE_URL=postgresql+asyncpg://document_insight:document_insight@localhost:5432/document_insight
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=document-insight
JWT_AUDIENCE=document-insight-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=document-insight
S3_SECRET_KEY=document-insight-local-only
S3_BUCKET_NAME=document-insight-originals
S3_REGION=us-east-1
UPLOAD_MAX_BYTES=26214400
REDIS_URL=redis://localhost:6379/0
RQ_INGESTION_QUEUE_NAME=ingestion
# Docker Compose injects EMBEDDING_BASE_URL from Docker Model Runner.
# Override this only when running the worker outside Compose.
# EMBEDDING_BASE_URL=http://localhost:12434/engines/v1
# EMBEDDING_API_KEY=replace-with-local-provider-key
