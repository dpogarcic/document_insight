# These endpoint values are for the Compose-managed API and worker.
DATABASE_URL=postgresql+asyncpg://document_insight:document_insight@database:5432/document_insight
# Dedicated application credentials are provisioned by bootstrap-roles after migration.
DATABASE_READ_PASSWORD=replace-with-read-password
DATABASE_WRITE_PASSWORD=replace-with-write-password
DATABASE_AUTH_PASSWORD=replace-with-auth-password
DATABASE_WORKER_PASSWORD=replace-with-worker-password
DATABASE_RECONCILER_PASSWORD=replace-with-reconciler-password
DATABASE_MONITOR_PASSWORD=replace-with-monitor-password
DATABASE_READ_URL=postgresql+asyncpg://di_api_read_login:replace-with-read-password@database:5432/document_insight
DATABASE_WRITE_URL=postgresql+asyncpg://di_api_write_login:replace-with-write-password@database:5432/document_insight
DATABASE_AUTH_URL=postgresql+asyncpg://di_auth_login:replace-with-auth-password@database:5432/document_insight
DATABASE_WORKER_URL=postgresql+asyncpg://di_worker_login:replace-with-worker-password@database:5432/document_insight
DATABASE_RECONCILER_URL=postgresql+asyncpg://di_reconciler_login:replace-with-reconciler-password@database:5432/document_insight
DATABASE_MONITOR_URL=postgresql+asyncpg://di_monitor_login:replace-with-monitor-password@database:5432/document_insight
# Required only for the disposable PostgreSQL test profile. Use distinct local secrets.
TEST_DATABASE_OWNER_PASSWORD=replace-with-test-owner-password
TEST_DATABASE_RUNTIME_PASSWORD=replace-with-test-runtime-password
TEST_DATABASE_RUNTIME_URL=postgresql+asyncpg://document_insight_test_runtime:replace-with-test-runtime-password@127.0.0.1:5433/document_insight_test
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=document-insight
JWT_AUDIENCE=document-insight-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
S3_ENDPOINT_URL=http://object-storage:9000
S3_ACCESS_KEY=document-insight
S3_SECRET_KEY=document-insight-local-only
S3_BUCKET_NAME=document-insight-originals
S3_REGION=us-east-1
UPLOAD_MAX_BYTES=26214400
REDIS_URL=redis://redis:6379/0
RQ_INGESTION_QUEUE_NAME=ingestion
# Periodically republishes durable queued work and recovers stale transient jobs.
JOB_RECONCILIATION_INTERVAL_SECONDS=60
# Required only when the optional observability Compose profile is enabled.
METRICS_BEARER_TOKEN=replace-with-a-long-random-monitoring-token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Testing123!!
# JSON array of browser origins permitted to call the public API. Set only your deployed UI origins in production.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Required for embeddings, LLM reranking, and evidence-grounded generation.
# Do not commit a real key.
MISTRAL_API_KEY=replace-with-mistral-api-key
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
