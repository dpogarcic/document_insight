{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "Document Insight",
      "folder": "Document Insight",
      "interval": "1m",
      "rules": [
        {
          "uid": "di_api_unavailable",
          "title": "DocumentInsightApiUnavailable",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "editorMode": "code",
                "expr": "up{job=\"document-insight-api\"} == 0",
                "instant": true,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "$A > 0",
                "type": "math",
                "refId": "B"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Alerting",
          "for": "2m",
          "annotations": {
            "summary": "Document Insight API metrics target is unavailable"
          },
          "labels": {
            "severity": "critical"
          },
          "isPaused": false
        },
        {
          "uid": "di_api_high5xx_ratio",
          "title": "DocumentInsightApiHigh5xxRatio",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "editorMode": "code",
                "expr": "sum(rate(document_insight_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(document_insight_http_requests_total[5m])), 1) > 0.05",
                "instant": true,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "$A > 0",
                "type": "math",
                "refId": "B"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Alerting",
          "for": "10m",
          "annotations": {
            "summary": "Document Insight API 5xx ratio exceeds 5%"
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        },
